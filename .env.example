DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/samkvetlo
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5433/samkvetlo_test
PAYLOAD_SECRET=
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret
SERVICE_TOKEN_READ=dev-read-token
SERVICE_TOKEN_WRITE=dev-write-token
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
EMAIL_ADAPTER=console
SMS_ADAPTER=console
CRON_SECRET=dev-cron-secret
IP_HASH_SALT=dev-salt
SEED_ADMIN_EMAIL=admin@samkvetlo.local
SEED_ADMIN_PASSWORD=
# dev only (ADR 0018, T5.17): a stable TOTP secret for the seeded dev admin,
# so `pnpm seed` gives the same authenticator entry every run instead of a
# new one each time. Leave unset to get a fresh, printed-once secret.
# SEED_ADMIN_TOTP_SECRET=
# prod only (ADR 0013): S3_BUCKET= S3_PRIVATE_BUCKET= S3_ENDPOINT= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_REGION=auto
# prod only (T5.13, ADR 0012 §7, ADR 0014 §9): the DDL role (docs/db-roles.sql),
# used only by `payload migrate` in the Vercel build command (vercel.json) —
# never set as the runtime DATABASE_URL.
# DATABASE_URL_MIGRATOR=
# prod only (T5.10, ADR 0014 §11): unset disables the Sentry SDK entirely
# (`if (dsn) Sentry.init(...)` in instrumentation.ts).
# SENTRY_DSN=
# Only needed to upload source maps (CI) — a missing token skips that step,
# it does not fail the build.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# prod only, break-glass (ADR 0016), set + Redeploy only while the owner is
# outside Georgia, then remove + Redeploy again: ADMIN_BREAK_GLASS="<IP>;<expiresAt ISO-8601 UTC, <= 72h out>"
# e.g. ADMIN_BREAK_GLASS=203.0.113.7;2026-10-01T18:00:00Z — see docs/runbooks/break-glass.md
# ADMIN_BREAK_GLASS=
