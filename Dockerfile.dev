# Dev image for the root `docker compose up` (see ../docker-compose.yml).
# Not used in production — see `Dockerfile` for the standalone prod build.
# Source code and node_modules are bind-mounted / volume-mounted at runtime
# (root docker-compose.yml); this image only provides the Node + pnpm toolchain.
FROM node:22.17.0-alpine

# Needed for Next.js on Alpine, see https://github.com/nodejs/docker-node/tree/main/docs/BestPractices.md#nodealpine
RUN apk add --no-cache libc6-compat

# sharp's bundled librsvg segfaults rendering SVG <text> without a fontconfig
# config + at least one font (scripts/seed.ts placeholder image, int tests).
RUN apk add --no-cache fontconfig font-dejavu

RUN corepack enable && corepack prepare pnpm@10.29.3 --activate

WORKDIR /app

# Install on every start (fast: pnpm store is a named volume) so the container
# always has linux-native node_modules, then run the dev server with hot reload.
# confirm-modules-purge=false: no TTY in the container, so let pnpm rebuild the
# node_modules volume itself when the store/Node version changes.
CMD ["sh", "-c", "pnpm install --config.confirm-modules-purge=false && pnpm dev"]
