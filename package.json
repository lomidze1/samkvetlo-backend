{
  "name": "samkvetlo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "სამკვეთლო backend: Payload CMS ადმინი + /api/public/* DTO API (ADR 0012)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "check:ka": "tsx scripts/check-hardcoded-ka.ts",
    "check:migrations": "tsx scripts/check-migrations-clean.ts",
    "check:importmap": "tsx scripts/check-importmap-clean.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "seed": "tsx scripts/seed.ts",
    "seed:base": "tsx scripts/seed.ts --base",
    "rates:sync": "tsx scripts/rates-sync.ts",
    "admin:totp": "tsx scripts/admin-totp.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.unit.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@sentry/nextjs": "10.75.0",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "file-type": "22.1.0",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "otpauth": "9.5.2",
    "payload": "3.89.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.9",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
